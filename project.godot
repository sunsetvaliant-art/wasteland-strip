; Engine configuration file.
config_version=5

[application]

config/name="Wasteland"
config/description="Overgrown Tweed Valley survival and vehicle building"
config/version="0.1.0"
run/main_scene="res://scenes/launcher.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.06, 0.07, 0.06, 1)
boot_splash/show_image=false

[autoload]

Boot="*res://scripts/boot.gd"
Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.9, 1)

[debug]

file_logging/enable_file_logging=true
